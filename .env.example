# Runtime root used by docker-compose for per-server data and certificates.
# On each server keep a single active `.env` with the values for that sede.
# In locale use the same standard single directory: `./runtime`.
MARCATEMPO_RUNTIME_DIR=./runtime
# Tag immutabile consigliato in produzione; il default resta `latest`.
MARCATEMPO_IMAGE=zibola/marcatempo:latest

# Bootstrap password for the fixed system admin user `admin`.
# Used only when the database has no system admin yet.
DEFAULT_SYSTEM_ADMIN_PASSWORD=cambia_subito_questa_password

# Safe default for new installations: keep device sync disabled until the
# correct sede configuration has been verified.
ANVIZ_SYNC_ENABLED=false

# Device configuration for the current sede.
# Format: DEVICE_ID@IP,DEVICE_ID@IP
# Example Napoli:  ANVIZ_DEVICES=1@192.168.1.245,2@192.168.1.246
# Example Ferrara: ANVIZ_DEVICES=3@192.168.10.245
ANVIZ_DEVICES=

# Optional subset of configured device IDs to keep active.
# Leave empty to activate all configured devices for the sede.
ANVIZ_ACTIVE_DEVICE_IDS=

# Optional compose/runtime settings
TZ=Europe/Rome
PORT=8080
BACKUP_HOUR=23
BACKUP_MINUTE=59
BACKUP_ON_STARTUP=false
ANVIZ_SIMPLIFIED_DEVICE_RAW_ACTIONS=true
ANVIZ_AUTO_SYNC_STAFF=false
ANVIZ_MANUAL_SYNC_STAFF=false
ANVIZ_HEALTHCHECK_ENABLED=true
ANVIZ_HEALTHCHECK_AUTOMATIC=true
ANVIZ_HEALTHCHECK_INTERVAL_SECONDS=60
ANVIZ_HEALTHCHECK_TIMEOUT_SECONDS=3
ANVIZ_HEALTHCHECK_PORT=5010
ANVIZ_HEALTHCHECK_INCLUDE_INACTIVE=true
ANVIZ_HEALTHCHECK_EVENT_BUFFER=100
# Se > 0, la dashboard admin genera assenze sintetiche solo per chi ha almeno
# una timbratura reale entro N giorni dalla fine del periodo visibile.
# Utile su sedi piccole come Ferrara per non riempire la UI di rossi non rilevanti.
ADMIN_SYNTHETIC_ABSENCE_LOOKBACK_DAYS=0

# SNMP v2c trap opzionale su cambio stato device (online/offline).
SNMP_TRAP_ENABLED=false
SNMP_TRAP_TARGET=
SNMP_TRAP_PORT=162
SNMP_TRAP_COMMUNITY=public
SNMP_TRAP_BASE_OID=.1.3.6.1.4.1.53864.1

# Merge frontend/logico di dipendenti duplicati (es. EX badge) senza SQL manuale.
# Formato: ALIAS_ID>CANONICAL_ID separati da virgola.
# Esempio: EMPLOYEE_ALIAS_MAPPINGS=142>37,143>37
EMPLOYEE_ALIAS_MAPPINGS=
# Se true, al boot disabilita prima tutti gli alias presenti e applica solo quelli qui sopra.
EMPLOYEE_ALIAS_REPLACE=false

# Confronta lo storico badge temporale con gli alias senza modificare API o record.
# Valori ammessi: off, shadow. Usare shadow solo dopo la migrazione DB versione 1.
# off: alias legacy; shadow: sola verifica; active: resolver temporale per persona
BADGE_HISTORY_MODE=off
