# Runtime root used by docker-compose for per-server data and certificates.
# On each server keep a single active `.env` with the values for that sede.
MARCATEMPO_RUNTIME_DIR=./runtime

# Bootstrap password for the fixed system admin user `admin`.
# Used only when the database has no system admin yet.
DEFAULT_SYSTEM_ADMIN_PASSWORD=cambia_subito_questa_password

# Safe default for new installations: keep device sync disabled until the
# correct sede configuration has been verified.
ANVIZ_SYNC_ENABLED=false

# Device configuration for the current sede.
# Format: DEVICE_ID@IP,DEVICE_ID@IP
# Example Napoli:  ANVIZ_DEVICES=1@192.168.1.245,2@192.168.1.246
# Example Ferrara: ANVIZ_DEVICES=3@192.168.10.245
ANVIZ_DEVICES=

# Optional subset of configured device IDs to keep active.
# Leave empty to activate all configured devices for the sede.
ANVIZ_ACTIVE_DEVICE_IDS=

# Optional compose/runtime settings
TZ=Europe/Rome
PORT=8080
BACKUP_HOUR=23
BACKUP_MINUTE=59
BACKUP_ON_STARTUP=false
